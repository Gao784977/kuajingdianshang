# =============================================================================
# .env.example for Opportunity Analysis Tool (V3.2)
# =============================================================================
# Copy this file to .env and fill in values for the current machine.
# Never commit .env to Git. Each machine uses its own secrets and paths.
#
# All variables below are actually read by backend/config.py.
# Variable names MUST match backend/config.py exactly — do not invent new ones.
# The CLI modules (src/modules/*) do NOT read environment variables; their
# defaults are hardcoded CLI flags. Only the V3.2 web backend reads .env.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Environment label. Use "local" for development, "production" for deployment.
APP_ENV=local

# Host and port the backend listens on. Use 127.0.0.1 for local-only access.
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------------
# Authentication (SENSITIVE — set locally per machine, never commit)
# ---------------------------------------------------------------------------
# Bootstrap admin token used only to create the first invitation codes.
# Leave empty to disable bootstrap. Set a strong random value when first
# setting up a machine, then rotate or unset after invitation codes exist.
ADMIN_BOOTSTRAP_TOKEN=<SET_LOCALLY>

# Session cookie name and time-to-live in seconds (default 86400 = 24h).
SESSION_COOKIE_NAME=session_id
SESSION_TTL_SECONDS=86400

# Per-minute login rate limit from a single source (default 10).
LOGIN_RATE_LIMIT_PER_MIN=10

# ---------------------------------------------------------------------------
# Cookie security
# ---------------------------------------------------------------------------
# Set to true when serving over HTTPS. Defaults to true when APP_ENV=production.
SESSION_COOKIE_SECURE=false
# Cookie SameSite policy: Lax / Strict / None.
SESSION_COOKIE_SAMESITE=Lax

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for browser requests.
# Empty list means same-origin only. Example: https://example.com,https://app.example.com
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# File upload
# ---------------------------------------------------------------------------
# Maximum upload size in megabytes (default 50).
MAX_UPLOAD_SIZE_MB=50
# Allowed upload extensions are fixed in backend/config.py: xlsx, csv, json.

# ---------------------------------------------------------------------------
# Storage paths (each machine can override)
# ---------------------------------------------------------------------------
# Root data directory. Default "data" (relative to project root).
DATA_DIR=data
# User upload storage (auto-created under DATA_DIR).
# WEB_STORAGE_DIR=data/web_storage
# Report output directory (auto-created under DATA_DIR).
# OUTPUT_DIR=data/output
# SQLite database path (auto-created under DATA_DIR).
# SQLITE_PATH=data/web.db

# ---------------------------------------------------------------------------
# URL fetch security (disabled by default)
# ---------------------------------------------------------------------------
# Master switch for URL fetching. Only enable when you accept the SSRF
# safeguards in backend/services/url_security.py.
URL_FETCH_ENABLED=false
# Maximum HTTP redirects followed (default 3).
URL_FETCH_MAX_REDIRECTS=3
# Maximum response size in bytes (default 5242880 = 5 MB).
URL_FETCH_MAX_BYTES=5242880
# Connect timeout in seconds (default 5).
URL_FETCH_CONNECT_TIMEOUT=5
# Read timeout in seconds (default 10).
URL_FETCH_READ_TIMEOUT=10

# ---------------------------------------------------------------------------
# Mock data (demo / test only)
# ---------------------------------------------------------------------------
# When true, the web backend may return deterministic mock data for demo
# purposes. Leave false on any machine that handles real user input.
MOCK_DATA_ENABLED=false
