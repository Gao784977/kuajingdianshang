# Environment variables for veFaaS deployment
# Copy to your function's environment configuration.

# Environment
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Admin bootstrap invitation token (REQUIRED for first user)
ADMIN_BOOTSTRAP_TOKEN=your-admin-token-here

# Storage backend: local | tos
STORAGE_BACKEND=tos
TOS_BUCKET=your-bucket-name
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
# TOS credentials (or use IAM role in veFaaS)
# TOS_ACCESS_KEY=
# TOS_SECRET_KEY=

# Database (use managed MySQL/Postgres in production)
DATABASE_URL=mysql+pymysql://user:password@host:3306/product_research

# Security
SESSION_TTL_SECONDS=86400
MAX_UPLOAD_SIZE_MB=50
# Comma-separated allowed origins (for CORS)
ALLOWED_ORIGINS=https://your-domain.com

# URL fetch (SSRF protection)
URL_FETCH_ENABLED=false
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_SIZE_MB=10
